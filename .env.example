# Frontend API configuration (leave blank to use same-origin /api proxy)
VITE_API_BASE_URL=""

# Flask Backend Server Configuration
FLASK_HOST="0.0.0.0"
FLASK_PORT="5001"
FLASK_DEBUG="false"
FLASK_BACKEND_URL="http://127.0.0.1:5001"

# Persistent SQLite database location (mount a persistent disk in production)
DATABASE_PATH="./instance/spamguard.db"

# Security & ML Settings
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
MAX_REVIEW_LENGTH="5000"
TFIDF_MAX_FEATURES="3000"
TRAIN_TEST_SIZE="0.25"

# AI Studio Runtime Environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
